```
# Dependencies
go.mod
go.sum

# Compiled and build artifacts
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.out

# Go-specific build artifacts
bin/
pkg/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Build directories
build/
dist/
target/

# Python cache (if any Python files exist in the project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Node.js (if any JS files exist in the project)
node_modules/

# Virtual environments (if any Python files exist in the project)
venv/
.venv/
```